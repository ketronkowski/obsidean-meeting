{
  "name": "obsidean-meeting",
  "version": "0.2.2",
  "description": "Obsidian plugin for automated meeting note processing using the GitHub Copilot CLI",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "jest"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "meeting",
    "copilot",
    "ai"
  ],
  "author": "Kevin Tronkowski",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.10",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "obsidian": "latest",
    "ts-jest": "^29.4.11",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/jszip": "^3.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "obsidian": "<rootDir>/src/__tests__/helpers/obsidian-mock.ts"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "esModuleInterop": true,
          "allowSyntheticDefaultImports": true
        }
      }
    }
  }
}
